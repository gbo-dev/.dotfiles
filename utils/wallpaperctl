#!/usr/bin/env bash
set -euo pipefail

# Desktop wallpaper selection for Linux (awww) and macOS (System Events).
# macOS may ask the invoking terminal for Automation permission. This applies
# to the visible desktops on connected displays; other Spaces need Mac testing.
# Requires fd and realpath; macOS uses its built-in Bash and osascript.
#
# Environment overrides:
#   WALLPAPER_DIR        directory used by list (AWWW_WALLPAPER_DIR also supported)
#   WALLPAPER_DEFAULT    fallback used when no saved wallpaper is available
#   WALLPAPER_STATE_FILE persistent selection path
#   WALLPAPER_TRANSITION awww transition type (Linux only)
#   WALLPAPER_RESTORE_ATTEMPTS Linux startup daemon readiness attempts
#   WALLPAPER_RESTORE_DELAY delay in seconds between Linux startup attempts

WALLPAPER_DIR="${WALLPAPER_DIR:-${AWWW_WALLPAPER_DIR:-$HOME/.dotfiles/assets/wallpapers}}"
DEFAULT_WALLPAPER="${WALLPAPER_DEFAULT:-$WALLPAPER_DIR/night-32x9.png}"
STATE_FILE="${WALLPAPER_STATE_FILE:-${XDG_STATE_HOME:-$HOME/.local/state}/wallpaper/current}"
TRANSITION_TYPE="${WALLPAPER_TRANSITION:-none}"
RESTORE_ATTEMPTS="${WALLPAPER_RESTORE_ATTEMPTS:-20}"
RESTORE_DELAY="${WALLPAPER_RESTORE_DELAY:-0.25}"

die() {
    printf 'wallpaperctl: %s\n' "$*" >&2
    exit 1
}

usage() {
    cat >&2 <<'EOF'
Usage:
  wallpaperctl list
  wallpaperctl set FILE
  wallpaperctl restore
EOF
    exit 2
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || die "$1 is not installed"
}

load_wallpapers() {
    local wallpapers

    require_command fd
    [[ -d "$WALLPAPER_DIR" ]] || die "wallpaper directory not found: $WALLPAPER_DIR"

    wallpapers=$(
        fd --absolute-path --no-ignore --max-depth 1 --type f \
            --extension jpg \
            --extension jpeg \
            --extension png \
            --extension gif \
            --extension webp \
            . "$WALLPAPER_DIR" | sort -V
    ) || die "could not list wallpapers in: $WALLPAPER_DIR"

    [[ -n "$wallpapers" ]] || die "no wallpapers found in: $WALLPAPER_DIR"
    printf '%s\n' "$wallpapers"
}

saved_wallpaper() {
    local saved=""

    if [[ -r "$STATE_FILE" ]]; then
        saved=$(<"$STATE_FILE")
    fi

    printf '%s\n' "$saved"
}

remember_wallpaper() {
    local wallpaper="$1"
    local state_dir
    local temporary

    state_dir=$(dirname -- "$STATE_FILE")
    mkdir -p -- "$state_dir" || die "could not create state directory: $state_dir"
    temporary=$(mktemp "${STATE_FILE}.tmp.XXXXXX") || die "could not create state file"

    if ! printf '%s\n' "$wallpaper" >"$temporary"; then
        rm -f -- "$temporary"
        die "could not write wallpaper state"
    fi

    if ! mv -f -- "$temporary" "$STATE_FILE"; then
        rm -f -- "$temporary"
        die "could not save wallpaper state"
    fi
}

apply_wallpaper() {
    local requested="$1"
    local remember="${2:-yes}"
    local attempts="${3:-1}"
    local wallpaper
    local applied=false
    local attempt

    require_command realpath
    [[ -e "$requested" ]] || die "wallpaper not found: $requested"
    wallpaper=$(realpath -- "$requested" 2>/dev/null) || die "could not resolve wallpaper: $requested"
    [[ -f "$wallpaper" ]] || die "not a file: $wallpaper"

    case "$(uname -s)" in
        Linux)
            require_command awww
            [[ $attempts =~ ^[1-9][0-9]*$ ]] || die "invalid attempt count: $attempts"

            for ((attempt = 1; attempt <= attempts; attempt++)); do
                if awww img "$wallpaper" --transition-type "$TRANSITION_TYPE"; then
                    applied=true
                    break
                fi

                if ((attempt < attempts)); then
                    sleep "$RESTORE_DELAY"
                fi
            done

            [[ $applied == true ]] || die "awww failed to set wallpaper"
            ;;
        Darwin)
            require_command osascript
            # Pass the path as data, including any quotes or spaces in its name.
            osascript - "$wallpaper" >/dev/null <<'APPLESCRIPT' || die "macOS failed to set wallpaper"
on run argv
    set wallpaperPath to item 1 of argv
    tell application "System Events"
        set picture of every desktop to wallpaperPath
    end tell
end run
APPLESCRIPT
            ;;
        *)
            die "unsupported operating system: $(uname -s)"
            ;;
    esac

    if [[ $remember == yes ]]; then
        remember_wallpaper "$wallpaper"
    fi
}

restore_wallpaper() {
    local wallpaper

    wallpaper=$(saved_wallpaper)
    if [[ -z "$wallpaper" || ! -f "$wallpaper" ]]; then
        wallpaper="$DEFAULT_WALLPAPER"
    fi

    # A missing removable/local file falls back without erasing the preference.
    apply_wallpaper "$wallpaper" no "$RESTORE_ATTEMPTS"
}

case "${1:-}" in
    list)
        (($# == 1)) || usage
        load_wallpapers
        ;;
    set)
        (($# == 2)) || usage
        apply_wallpaper "$2"
        ;;
    restore)
        (($# == 1)) || usage
        restore_wallpaper
        ;;
    *)
        usage
        ;;
esac
