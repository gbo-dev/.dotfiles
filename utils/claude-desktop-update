#!/usr/bin/env bash

set -Eeuo pipefail

# User-local updater for Anthropic's official Claude Desktop Linux package.
# It intentionally executes no Debian maintainer scripts.

readonly REPO_ROOT="https://downloads.claude.ai/claude-desktop/apt/stable"
readonly INRELEASE_URL="$REPO_ROOT/dists/stable/InRelease"
readonly EXPECTED_KEY_FINGERPRINT="31DDDE24DDFAB679F42D7BD2BAA929FF1A7ECACE"

readonly LOCAL_LIB="${HOME}/.local/lib"
readonly APP_HOME="$LOCAL_LIB/claude-desktop"
readonly BIN_DIR="${HOME}/.local/bin"
readonly DESKTOP_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
readonly PIXMAP_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/pixmaps"
readonly CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/claude-desktop-updater"
readonly VERSION_MARKER=".package-version"

MODE="update"
TMP_DIR=""

usage() {
  cat <<'EOF'
Usage: claude-desktop-update [--check | --status | --help]

  --check      Verify Anthropic's signed repository and report available versions
  --status     Show the installed version
  --help       Show this help

With no option, download, verify, and install an available update.
On Arch, warn if socat, qemu-system-x86, or edk2-ovmf are missing.
EOF
}

die() {
  printf 'claude-desktop-update: %s\n' "$*" >&2
  exit 1
}

note() {
  printf '%s\n' "$*"
}

cleanup() {
  if [[ -n "$TMP_DIR" && -d "$TMP_DIR" ]]; then
    rm -rf -- "$TMP_DIR"
  fi
}
trap cleanup EXIT INT TERM

require_commands() {
  local command_name
  for command_name in awk base64 bsdtar curl date find flock gpg gpgv head install ln \
    mkdir mktemp mv readlink rm sed sha256sum sort stat tail uname; do
    command -v "$command_name" >/dev/null 2>&1 || die "required command not found: $command_name"
  done
}

select_architecture() {
  case "$(uname -m)" in
    x86_64) printf 'amd64\n' ;;
    aarch64|arm64) printf 'arm64\n' ;;
    *) die "unsupported processor architecture: $(uname -m)" ;;
  esac
}

