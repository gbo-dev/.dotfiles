curl_get() {
  local url="$1"
  local destination="$2"
  curl \
    --proto '=https' \
    --tlsv1.2 \
    --fail \
    --silent \
    --show-error \
    --location \
    --retry 3 \
    --output "$destination" \
    "$url"
}

current_version() {
  local marker="$APP_HOME/$VERSION_MARKER"
  [[ -r "$marker" ]] || return 0
  head -n1 "$marker"
}

# The Packages index lists every published version; print the newest stanza as
# "version<TAB>filename<TAB>size<TAB>sha256".
newest_package() {
  local packages_file="$1"
  awk -v RS= -F'\n' '
    {
      v = f = s = h = ""
      for (i = 1; i <= NF; i++) {
        if ($i ~ /^Package: /) p = substr($i, 10)
        else if ($i ~ /^Version: /) v = substr($i, 10)
        else if ($i ~ /^Filename: /) f = substr($i, 11)
        else if ($i ~ /^Size: /) s = substr($i, 7)
        else if ($i ~ /^SHA256: /) h = substr($i, 9)
      }
      if (p == "claude-desktop") printf "%s\t%s\t%s\t%s\n", v, f, s, h
    }
  ' "$packages_file" | sort -V -k1,1 | tail -n1
}

fetch_release_metadata() {
  local architecture="$1"
  local inrelease="$TMP_DIR/InRelease"
  local packages="$TMP_DIR/Packages"
  local keyring="$TMP_DIR/claude-archive-keyring.gpg"
  local packages_relative="main/binary-${architecture}/Packages"
  local packages_url="$REPO_ROOT/dists/stable/$packages_relative"

  write_repository_key "$keyring"
  curl_get "$INRELEASE_URL" "$inrelease"

  if ! gpgv --keyring "$keyring" "$inrelease" >"$TMP_DIR/gpgv.out" 2>&1; then
    sed -n '1,20p' "$TMP_DIR/gpgv.out" >&2
    die "Anthropic repository signature verification failed"
  fi

  local expected_packages_hash
  expected_packages_hash="$(awk -v wanted="$packages_relative" '
    $0 == "SHA256:" { in_sha256 = 1; next }
    in_sha256 && $0 ~ /^[[:alnum:]-]+:/ { in_sha256 = 0 }
    in_sha256 && $3 == wanted { print $1; exit }
  ' "$inrelease")"
  [[ "$expected_packages_hash" =~ ^[[:xdigit:]]{64}$ ]] ||
    die "signed repository index does not describe $packages_relative"

  curl_get "$packages_url" "$packages"
  printf '%s  %s\n' "$expected_packages_hash" "$packages" | sha256sum --check --status ||
    die "package index checksum verification failed"

  local newest
  newest="$(newest_package "$packages")"
  [[ -n "$newest" ]] || die "package index does not list claude-desktop"
  IFS=$'\t' read -r REMOTE_VERSION REMOTE_FILENAME REMOTE_SIZE REMOTE_SHA256 <<<"$newest"

  [[ "$REMOTE_VERSION" =~ ^[0-9][0-9A-Za-z.+:~_-]*$ ]] || die "invalid version in package index"
  [[ "$REMOTE_FILENAME" =~ ^pool/main/c/claude-desktop/claude-desktop_[0-9A-Za-z.+:~_-]+_${architecture}\.deb$ ]] ||
    die "invalid filename in package index"
  [[ "$REMOTE_SIZE" =~ ^[0-9]+$ ]] || die "invalid package size in package index"
  [[ "$REMOTE_SHA256" =~ ^[[:xdigit:]]{64}$ ]] || die "invalid package checksum in package index"
}

warn_arch_recommendations() {
  command -v pacman >/dev/null 2>&1 || return 0

  # These Arch packages support Claude Desktop's local sandbox/VM features.
  local package
  local -a missing=()
  for package in socat qemu-system-x86 edk2-ovmf; do
    if ! pacman -Q "$package" >/dev/null 2>&1; then
      missing+=("$package")
    fi
  done
  if ((${#missing[@]} > 0)); then
    printf 'Warning: missing recommended Claude Desktop packages: %s\n' "${missing[*]}" >&2
    printf 'Some Claude Desktop features may be unavailable. To install on Arch:\n' >&2
    printf '  sudo pacman -S --needed %s\n' "${missing[*]}" >&2
  fi
}

is_newer_version() {
  local candidate="$1"
  local installed="$2"
  [[ "$candidate" != "$installed" ]] &&
    [[ "$(printf '%s\n%s\n' "$candidate" "$installed" | sort -V | tail -n1)" == "$candidate" ]]
}

ensure_integration() {
  local release="$1"
  mkdir -p "$BIN_DIR" "$DESKTOP_DIR" "$PIXMAP_DIR"

  if [[ ! -e "$BIN_DIR/claude-desktop" && ! -L "$BIN_DIR/claude-desktop" ]]; then
    ln -s ../lib/claude-desktop/claude-desktop "$BIN_DIR/claude-desktop"
  elif [[ ! -L "$BIN_DIR/claude-desktop" ]]; then
    die "$BIN_DIR/claude-desktop exists and is not a symbolic link"
  fi

  if [[ ! -e "$DESKTOP_DIR/claude-desktop.desktop" ]]; then
    cat >"$DESKTOP_DIR/claude-desktop.desktop" <<EOF
[Desktop Entry]
Name=Claude
Comment=Desktop application for Claude.ai
GenericName=AI Assistant
Exec=$BIN_DIR/claude-desktop %U
Icon=$PIXMAP_DIR/claude-desktop.png
Type=Application
StartupNotify=true
StartupWMClass=com.anthropic.Claude
SingleMainWindow=true
Categories=Utility;Development;
Keywords=AI;Chat;Assistant;Claude;Code;LLM;
MimeType=x-scheme-handler/claude;
Actions=NewChat;NewCode;

[Desktop Action NewChat]
Name=New Chat
Exec=$BIN_DIR/claude-desktop "claude://claude.ai/new?surface=chat&source=desktop_action"

[Desktop Action NewCode]
Name=New Claude Code Session
Exec=$BIN_DIR/claude-desktop "claude://code/new?source=desktop_action"
EOF
    chmod 0644 "$DESKTOP_DIR/claude-desktop.desktop"
  fi

  if [[ -r "$release/.icon.png" ]]; then
    install -m 0644 "$release/.icon.png" "$PIXMAP_DIR/claude-desktop.png"
  fi

  if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database "$DESKTOP_DIR" >/dev/null 2>&1 || true
  fi
}

install_release() {
  local package="$TMP_DIR/claude-desktop.deb"
  local archive_dir="$TMP_DIR/deb"
  local root_dir="$TMP_DIR/root"
  local staging="$LOCAL_LIB/.claude-desktop-staging.$$"
  local old="$LOCAL_LIB/.claude-desktop-old.$$"
  local data_member control_member

  note "Downloading Claude Desktop $REMOTE_VERSION ($(awk -v bytes="$REMOTE_SIZE" 'BEGIN { printf "%.1f MiB", bytes / 1048576 }'))..."
  curl_get "$REPO_ROOT/$REMOTE_FILENAME" "$package"

  [[ "$(stat -c '%s' "$package")" == "$REMOTE_SIZE" ]] || die "downloaded package has the wrong size"
  printf '%s  %s\n' "$REMOTE_SHA256" "$package" | sha256sum --check --status ||
    die "downloaded package checksum verification failed"
  note "Verified Anthropic repository signature and package SHA-256."

  mkdir -p "$archive_dir" "$root_dir"
  data_member="$(bsdtar -tf "$package" | awk '/^data\.tar\./ { print; exit }')"
  control_member="$(bsdtar -tf "$package" | awk '/^control\.tar\./ { print; exit }')"
  [[ -n "$data_member" && -n "$control_member" ]] || die "Debian package is missing its data or control archive"
  bsdtar -xf "$package" -C "$archive_dir" "$data_member" "$control_member"
  bsdtar -xf "$archive_dir/$data_member" -C "$root_dir"
  rm -f -- "$package"

  local extracted="$root_dir/usr/lib/claude-desktop"
  [[ -x "$extracted/claude-desktop" ]] || die "package does not contain the expected claude-desktop executable"
  local control_version
  control_version="$(bsdtar -xOf "$archive_dir/$control_member" ./control 2>/dev/null |
    sed -n 's/^Version:[[:space:]]*//p' | head -n1)"
  [[ "$control_version" == "$REMOTE_VERSION" ]] || die "package control version does not match the signed index"

  printf '%s\n' "$REMOTE_VERSION" >"$extracted/$VERSION_MARKER"
  local icon
  icon="$(find "$root_dir/usr/share/icons/hicolor" -path '*/apps/claude-desktop.png' 2>/dev/null |
    sort -V | tail -n1)"
  [[ -z "$icon" ]] || install -m 0644 "$icon" "$extracted/.icon.png"

  # Single install: swap in the new tree, then delete the old one.
  mv "$extracted" "$staging"
  if [[ -e "$APP_HOME" || -L "$APP_HOME" ]]; then
    mv "$APP_HOME" "$old"
  fi
  mv "$staging" "$APP_HOME"
  rm -rf -- "$old"
  ensure_integration "$APP_HOME"

  note "Installed Claude Desktop $REMOTE_VERSION."
  note "Fully quit and reopen Claude to use the new version."
}

show_status() {
  note "Installed version: $(current_version || true)"
  [[ -d "$APP_HOME" ]] || note "Not installed."
}

main() {
  if [[ $# -gt 1 ]]; then
    usage >&2
    exit 2
  fi
  case "${1:-}" in
    "") MODE="update" ;;
    --check) MODE="check" ;;
    --status) MODE="status" ;;
    --help|-h) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac

  warn_arch_recommendations
  require_commands
  if [[ "$MODE" == "status" ]]; then
    show_status
    exit
  fi

  mkdir -p "$CACHE_DIR" "$LOCAL_LIB"
  exec 9>"$CACHE_DIR/update.lock"
  flock -n 9 || die "another updater process is already running"

  TMP_DIR="$(mktemp -d "$CACHE_DIR/run.XXXXXX")"
  local architecture installed
  architecture="$(select_architecture)"
  fetch_release_metadata "$architecture"
  installed="$(current_version)"

  note "Installed: ${installed:-none}"
  note "Available: $REMOTE_VERSION"
  note "Repository signature: verified ($EXPECTED_KEY_FINGERPRINT)"

  if [[ "$MODE" == "check" ]]; then
    if [[ -z "$installed" ]] || is_newer_version "$REMOTE_VERSION" "$installed"; then
      note "Update available."
    elif [[ "$REMOTE_VERSION" == "$installed" ]]; then
      note "Already up to date."
    else
      note "Installed version is newer than the repository version."
    fi
    exit
  fi

  if [[ "$REMOTE_VERSION" == "$installed" ]]; then
    note "Already up to date."
    exit
  fi
  if [[ -n "$installed" ]] && ! is_newer_version "$REMOTE_VERSION" "$installed"; then
    die "refusing to replace newer local version $installed with $REMOTE_VERSION"
  fi

  install_release
}

main "$@"
