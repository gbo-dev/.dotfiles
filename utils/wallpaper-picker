#!/usr/bin/env bash
set -euo pipefail

# Pick a wallpaper with fzf, preview it via Kitty's graphics protocol, and
# persist the selection through wallpaperctl.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WALLPAPERCTL="${SCRIPT_DIR}/wallpaperctl"
FZF_STYLE_FILE="${SCRIPT_DIR}/../fzf/.config/fzf/fzfrc"

die() {
    printf 'wallpaper-picker: %s\n' "$*" >&2
    exit 1
}

for dependency in fzf kitty; do
    command -v "$dependency" >/dev/null 2>&1 || die "$dependency is not installed"
done

[[ -x "$WALLPAPERCTL" ]] || die "wallpaperctl is not executable: $WALLPAPERCTL"
[[ -r "$FZF_STYLE_FILE" ]] || die "fzf style file not found: $FZF_STYLE_FILE"

wallpaper_list=$("$WALLPAPERCTL" list) || exit $?
mapfile -t wallpapers <<<"$wallpaper_list"

((${#wallpapers[@]} > 0)) || die "no wallpapers found"

preview='kitty +kitten icat \
    --clear \
    --transfer-mode=memory \
    --unicode-placeholder \
    --stdin=no \
    --place "${FZF_PREVIEW_COLUMNS}x${FZF_PREVIEW_LINES}@0x0" \
    -- {}'

selected=$(
    printf '%s\n' "${wallpapers[@]}" |
        FZF_DEFAULT_OPTS_FILE="$FZF_STYLE_FILE" fzf \
            --delimiter=/ \
            --with-nth=-1 \
            --height=100% \
            --preview-window='right,65%,border-left' \
            --preview-label=' preview ' \
            --preview "$preview" || true
)

[[ -n "$selected" ]] || exit 0
[[ -f "$selected" ]] || die "selected file no longer exists: $selected"

"$WALLPAPERCTL" set "$selected"

if command -v notify-send >/dev/null 2>&1; then
    notify-send "Wallpaper" "$(basename "$selected")"
fi
