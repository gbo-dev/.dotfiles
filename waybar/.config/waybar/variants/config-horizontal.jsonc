{
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 8,

  "modules-left": ["custom/power", "niri/workspaces", "custom/workspace-count", "custom/workspace-apps"],

  "modules-center": [],

  "modules-right": [
    "tray",
    "custom/notification",
    "custom/mic",
    "bluetooth",
    "wireplumber",
    "custom/cpu-temp",
    "custom/gpu-temp",
    "clock",
  ],

  "tray": {
    "icon-size": 14,
    "spacing": 16,
    "tooltip": true,
  },

  "bluetooth": {
    "format": "\udb80\udcaf",
    "format-disabled": "\udb80\udcb2",
    "format-off": "\udb80\udcb2",
    "format-on": "\udb80\udcb3",
    "format-connected": "\udb80\udcb1",
    "tooltip-format": "Bluetooth: {num_connections} connected\n\nLeft: Bluetooth manager\nMiddle: Connect XM4 (re-pair on failure)\nRight: Toggle Bluetooth",
    "tooltip-format-connected": "Connected to:\n\n{device_alias}\nBattery: {device_battery_percentage}%\n\nLeft: Bluetooth manager\nMiddle: Connect XM4 (re-pair on failure)\nRight: Toggle Bluetooth",
    "on-click-middle": "~/.config/waybar/scripts/xm4-connect.sh",
    "on-click": "kitty bluetui",
    "on-click-right": "~/.config/waybar/scripts/bluetooth.sh",
  },

  "custom/power": {
    "exec": "~/.config/waybar/scripts/power-menu.sh --watch",
    "return-type": "json",
    "restart-interval": 5,
    "format": "\uf011",
    "on-click": "~/.local/bin/gpui-cast --menu power-menu",
  },

  "custom/workspace-count": {
    "exec": "~/.config/waybar/scripts/workspace-windows.sh count",
    "return-type": "json",
    "hide-empty-text": true,
    "restart-interval": 5,
  },

  "custom/workspace-apps": {
    "exec": "~/.config/waybar/scripts/workspace-windows.sh names",
    "return-type": "json",
    "restart-interval": 5,
    "escape": true,
    "tooltip": false,
    "max-length": 100,
  },

  "niri/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "empty": "◇",
      "default": "◆",
    },
    "on-scroll-up": "niri msg action focus-workspace-up",
    "on-scroll-down": "niri msg action focus-workspace-down",
  },

  "clock": {
    "align": 0.5,
    "format": "{:%a %b %e   %H:%M}",
    "tooltip-format": "<span size=\"18432\" font_family=\"Iosevka\">{calendar}</span>",
    "calendar": {
      "on-scroll": 1,
      "format": {
        "today": "<b>{}</b>",
      },
    },
    "actions": {
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down",
    },
  },

  "custom/cpu-temp": {
    "exec": "~/.config/waybar/scripts/temperature.sh cpu --watch 3",
    "return-type": "json",
    "restart-interval": 5,
    "tooltip": true,
    "on-click": "kitty btop"
  },

  "custom/gpu-temp": {
    "exec": "~/.config/waybar/scripts/gpu-temp.sh --watch 5",
    "return-type": "json",
    "restart-interval": 5,
    "tooltip": true,
    "on-click": "lact",
  },

  "wireplumber": {
    "format": "{volume}%",
    "format-muted": "󰖁",
    "scroll-step": 5,
    "max-volume": 100,
    "tooltip-format": "Output: {node_name}\nVolume: {volume}%\n\nScroll: 5% steps\nRight-click: mute/unmute\nClick: audio settings",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click": "pavucontrol",
  },

  "custom/notification": {
    "exec": "swaync-client -swb",
    "return-type": "json",
    "restart-interval": 5,
    "format": "{icon}",
    "format-icons": {
        "notification": "󰂜",
        "none": "󰂜",
        "dnd-notification": "󰂠",
        "dnd-none": "󰪓",
        "inhibited-notification": "󰂛",
        "inhibited-none": "󰪑",
        "dnd-inhibited-notification": "󰂛",
        "dnd-inhibited-none": "󰪑"
    },
    "on-click-right": "swaync-client -d -sw",
    "escape": true,
    "tooltip": true
  },

  "custom/mic": {
    "exec": "~/.config/waybar/scripts/mic.sh --watch",
    "return-type": "json",
    "restart-interval": 5,
    "tooltip": true,
    "on-click": "pavucontrol",
    "on-click-right": "~/.config/waybar/scripts/mic.sh toggle",
  },
}
