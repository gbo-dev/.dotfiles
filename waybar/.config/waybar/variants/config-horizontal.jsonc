{
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 8,

  "modules-left": ["custom/power", "niri/workspaces"],

  "modules-center": [],

  "modules-right": [
    "tray",
    "custom/mic",
    "bluetooth",
    "wireplumber",
    "custom/cpu-temp",
    "custom/gpu-temp",
    "clock",
  ],

  "tray": {
    "icon-size": 14,
    "spacing": 8,
    "tooltip": true,
  },

  "bluetooth": {
    "format": "\udb80\udcaf",
    "format-disabled": "\udb80\udcb2",
    "format-off": "\udb80\udcb2",
    "format-on": "\udb80\udcb3",
    "format-connected": "\udb80\udcb1",
    "tooltip-format": "Bluetooth: {num_connections} connected",
    "tooltip-format-connected": "Connected to:\n\n{device_alias}\nBattery: {device_battery_percentage}%",
    "on-click": "kitty bluetui",
    "on-click-right": "~/.config/waybar/scripts/bluetooth.sh",
  },

  "custom/power": {
    "exec": "~/.config/waybar/scripts/power-menu.sh",
    "return-type": "json",
    "interval": 10,
    "format": "\uf011",
    "on-click": "~/.dotfiles/utils/powermenu-fuzzel",
  },

  "niri/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "empty": "◇",
      "default": "◆",
    },
    "on-scroll-up": "niri msg action focus-workspace-up",
    "on-scroll-down": "niri msg action focus-workspace-down",
  },

  "clock": {
    "format": "{:%a %b %e   %H:%M}",
    "tooltip-format": "<span size=\"18432\" font_family=\"Iosevka\">{calendar}</span>",
    "calendar": {
      "on-scroll": 1,
      "format": {
        "today": "<b><u>{}</u></b>",
      },
    },
    "actions": {
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down",
    },
  },

  "custom/cpu-temp": {
    "exec": "python3 ~/.config/waybar/scripts/temperature.py cpu",
    "return-type": "json",
    "interval": 3,
    "tooltip": true,
    "on-click": "kitty btop"
  },

  "custom/gpu-temp": {
    "exec": "~/.config/waybar/scripts/gpu-temp.sh",
    "return-type": "json",
    "interval": 5,
    "tooltip": true,
    "on-click": "lact",
  },

  "wireplumber": {
    "format": "{volume}%",
    "format-muted": "󰖁",
    "on-click": "pavucontrol",
  },

  "custom/mic": {
    "exec": "~/.config/waybar/scripts/mic.sh",
    "return-type": "json",
    "interval": 1,
    "tooltip": true,
    "on-click": "pavucontrol",
    "on-click-right": "~/.config/waybar/scripts/mic.sh toggle",
  },
}
