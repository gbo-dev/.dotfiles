{
  "include": ["~/.config/waybar/variants/modules.jsonc"],

  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 8,

  "modules-left": ["custom/power", "niri/workspaces", "custom/workspace-count", "custom/workspace-apps"],

  "modules-center": [],

  "modules-right": [
    "tray",
    "custom/notification",
    "custom/mic",
    "bluetooth",
    "wireplumber",
    "custom/cpu-temp",
    "custom/gpu-temp",
    "clock",
  ],

  "tray": {
    "icon-size": 14,
    "spacing": 16,
  },

  "clock": {
    "align": 0.5,
    "format": "{:%a %b %e   %H:%M}",
  },

  "custom/workspace-count": {
    "exec": "~/.config/waybar/scripts/workspace-windows.sh count",
    "return-type": "json",
    "hide-empty-text": true,
    "restart-interval": 5,
  },

  "custom/workspace-apps": {
    "exec": "~/.config/waybar/scripts/workspace-windows.sh names",
    "return-type": "json",
    "restart-interval": 5,
    "escape": true,
    "tooltip": false,
    "max-length": 100,
  },
}
