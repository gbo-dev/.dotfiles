{
  "include": ["~/.config/waybar/variants/modules.jsonc"],

  "layer": "top",
  "position": "left",
  "width": 65,
  "spacing": 4,

  "modules-left": ["custom/power", "niri/workspaces"],

  "modules-center": ["clock"],

  "modules-right": [
    "tray",
    "custom/notification",
    "custom/mic",
    "bluetooth",
    "wireplumber",
    "custom/cpu-temp",
    "custom/gpu-temp",
  ],

  "tray": {
    "icon-size": 16,
    "spacing": 8,
  },

  "clock": {
    "format": "{:%H\n%M}",
  },
}
