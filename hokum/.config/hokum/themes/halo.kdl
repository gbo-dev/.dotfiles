// Halo: a dark card tinted with the sending app's colour, under a brighter glow of the same hue.
name "Halo"
tokens {
    width 500
    font-size 17
    icon-size 23
    badge-radius 7
    radius 12
    padding 0
    gap 8
    spacing 10
    border 1 "accent/40"
    shadow "glow"
    fill "accent-deep" // darkened by the template's veil
    mark "icon"
}
template "card" {
    col fill="deep/88" radius=12 padding=14 gap=8 {
        row gap=8 align="center" {
            badge
            text "{source}" size=15 weight=550 color="muted" lines=1 grow=#true
            text "{time}" size=15 color="faint"
            close
        }
        row gap=10 {
            col gap=2 grow=#true {
                if "summary" { text "{summary}" size=16.5 weight="title" }
                if "body" { text "{body}" size=16.5 color="muted" lines=8 }
                if "value" { progress }
            }
            if "image" { image width=44 height=44 radius=8 }
        }
        actions padding-x=-10
    }
}
