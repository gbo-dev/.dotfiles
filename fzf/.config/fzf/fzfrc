# gruvbox-baby palette. Each region (search, list, preview) gets its own box;
# the selected row is a faint warm band with a yellow bar on its left edge.
--style=full
--color=fg:#ebdbb2,fg+:#ebdbb2:bold,bg:-1,bg+:#3a2d11
--color=hl:#8ec07c,hl+:#fabd2f:bold,info:#665c54,marker:#8ec07c
--color=prompt:#fabd2f,spinner:#d4879c,pointer:#fabd2f,header:#83a598
--color=border:#504945,label:#83a598,query:#ebdbb2,gutter:-1
--color=input-border:#665c54,list-border:#504945,preview-border:#504945
--color=input-label:#fabd2f,preview-label:#665c54
--color=scrollbar:#665c54,separator:#504945,preview-bg:-1
--border=none
--input-border=rounded
--list-border=rounded
--preview-border=rounded
--input-label=" search "
--preview-label=" preview "
--prompt="󰍉 "
--pointer="▍"
--marker="▍"
--gutter=" "
--info=inline-right
--preview-window=right,55%,noinfo,hidden
--bind=alt-p:toggle-preview
